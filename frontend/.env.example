# ================================================================
# ReclaimX — Frontend Environment Variables
# Place this file at: frontend/.env
#
# NOTE: This is a STATIC vanilla HTML/JS site.
# Vercel does NOT inject .env variables into static HTML files.
# There are NO secrets here — this file is for documentation only.
#
# The only config the frontend needs is API_BASE, which is
# hardcoded in assets/js/main.js → window.API_BASE
# Change that one line when your backend URL changes.
# ================================================================

# Backend URL (hardcoded in assets/js/main.js — not read from here)
# Local:      http://localhost:5000
# Production: https://reclaimx.onrender.com
API_BASE=https://reclaimx.onrender.com

# ── Vercel Deployment Settings ──────────────────────────────
# In Vercel dashboard → Project Settings → General:
#   Root Directory: frontend
#   Build Command: (leave empty — no build needed)
#   Output Directory: . (dot = current directory)
#   Install Command: (leave empty)
#
# No environment variables need to be added in Vercel dashboard.
# The frontend has no secrets.
