{
  "rewrites": [
    { "source": "/",              "destination": "/index.html" },
    { "source": "/dashboard",     "destination": "/pages/dashboard.html" },
    { "source": "/browse",        "destination": "/pages/browse.html" },
    { "source": "/matches",       "destination": "/pages/matches.html" },
    { "source": "/login",         "destination": "/pages/login.html" },
    { "source": "/register",      "destination": "/pages/register.html" },
    { "source": "/report-lost",   "destination": "/pages/report-lost.html" },
    { "source": "/report-found",  "destination": "/pages/report-found.html" },
    { "source": "/profile",       "destination": "/pages/profile.html" },
    { "source": "/404",           "destination": "/pages/404.html" }
  ],
  "headers": [
    {
      "source": "/pages/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma",        "value": "no-cache" },
        { "key": "Expires",       "value": "0" }
      ]
    }
  ]
}
